---
interface Props {
  title: string;
  description: string;
  providers: string;
  slug: string;
  services?: string;
  userInvocable?: boolean;
  distributable?: boolean;
}

const { title, description, providers, slug, services, userInvocable, distributable = true } = Astro.props;

const providerLabel: Record<string, string> = {
  both:      'Bitbucket · Azure DevOps',
  bitbucket: 'Bitbucket',
  ado:       'Azure DevOps',
  none:      'All repos',
};

const label = providerLabel[providers] ?? 'All repos';

const serviceList = services
  ? services.split(',').map(s => s.trim()).filter(Boolean)
  : [];
---

<a
  href={`/pncli/skills/${slug}/`}
  class="not-prose group flex flex-col rounded-xl border-2 border-ink/15 bg-panel p-5 hover:border-ink/40 hover:-translate-y-0.5 hover:shadow-[0_4px_0_rgb(0_0_0/0.2)] transition-all"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-display text-base font-bold text-ink leading-snug">{title}</h3>
    <div class="flex items-center gap-1.5 shrink-0 mt-0.5">
      {!distributable && (
        <span class="font-mono text-[10px] text-coral border border-coral/40 bg-coral/5 px-1.5 py-0.5 rounded">example</span>
      )}
      {userInvocable && (
        <span class="font-mono text-[10px] text-gold border border-gold/40 bg-gold/5 px-1.5 py-0.5 rounded">/invoke</span>
      )}
      <span class="font-mono text-[10px] text-ink/45 border border-ink/15 bg-ink/5 px-1.5 py-0.5 rounded">
        {label}
      </span>
    </div>
  </div>
  <p class="text-sm text-ink/60 leading-relaxed flex-1 mb-4">{description}</p>
  {serviceList.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-3">
      {serviceList.map(svc => (
        <span class="font-mono text-[10px] text-chrome border border-ink/15 bg-ink/5 px-1.5 py-0.5 rounded">
          {svc}
        </span>
      ))}
    </div>
  )}
  <span class="font-mono text-xs font-semibold text-gold group-hover:underline">
    View skill →
  </span>
</a>
