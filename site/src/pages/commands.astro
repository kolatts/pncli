---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeadingAnchors from '../components/HeadingAnchors.astro';

const entry = await getEntry('docs', 'commands');
if (!entry) throw new Error('docs/commands entry not found — did the prebuild script run? (node scripts/parse-commands.mjs)');
const { Content } = await render(entry);
---

<Base title="Command Reference — pncli" description={entry.data.description}>
  <div class="max-w-3xl mx-auto px-6 py-10">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-gold mb-2">Docs</p>
      <h1 class="font-display headline-shadow text-4xl font-black text-ink tracking-tight mb-3">Command Reference</h1>
      <p class="text-ink/60">{entry.data.description}</p>
    </header>

    <div class="prose prose-neutral max-w-none
      prose-headings:font-display prose-headings:text-ink prose-headings:font-black
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-ink/10
      prose-h3:text-base prose-h3:mt-6 prose-h3:mb-2 prose-h3:font-mono
      prose-p:text-ink/70
      prose-li:text-ink/70 prose-li:text-sm prose-li:leading-relaxed
      prose-strong:text-ink
      prose-a:text-gold prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
      prose-code:font-mono prose-code:text-sm prose-code:text-ink prose-code:bg-ink/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-[#1e1e20] prose-pre:text-[#f2ead9] prose-pre:rounded-xl">
      <Content />
    </div>

    <HeadingAnchors levels="h2, h3" />

    <footer class="mt-12 text-xs font-mono text-ink/30">
      Auto-generated from <code class="bg-ink/5 px-1 py-0.5 rounded">src/services/*/commands.ts</code> — run <code class="bg-ink/5 px-1 py-0.5 rounded">node scripts/parse-commands.mjs</code> to refresh.
    </footer>
  </div>
</Base>
