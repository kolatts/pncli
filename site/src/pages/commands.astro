---
import Base from '../layouts/Base.astro';
import commandsData from '../generated/commands.json';

const { commands } = commandsData;

// Capitalize the first letter for section headings
function title(name: string) {
  return name.charAt(0).toUpperCase() + name.slice(1);
}
---

<Base
  title="Command Reference — pncli"
  description="Full reference for every pncli command, subcommand, and flag."
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-10">
      <p class="font-mono text-xs uppercase tracking-wider text-ink/40 mb-2">Docs</p>
      <h1 class="font-display text-4xl font-bold text-ink mb-3">Command Reference</h1>
      <p class="text-ink/60 max-w-xl">
        Every pncli command, subcommand, and flag — generated from the CLI itself.
        All commands output JSON; check <code class="font-mono text-xs bg-ink/5 px-1.5 py-0.5 rounded">ok</code> before accessing <code class="font-mono text-xs bg-ink/5 px-1.5 py-0.5 rounded">data</code>.
      </p>
    </header>

    <!-- Jump links -->
    <nav class="mb-10 flex flex-wrap gap-2" aria-label="Jump to command group">
      {commands.map(cmd => (
        <a
          href={`#cmd-${cmd.name}`}
          class="font-mono text-xs px-2.5 py-1 rounded border border-ink/15 text-ink/50 hover:border-coral/40 hover:text-coral transition-colors"
        >
          {cmd.name}
        </a>
      ))}
    </nav>

    {commands.map(cmd => (
      <section id={`cmd-${cmd.name}`} class="mb-16 scroll-mt-8">
        <div class="flex items-baseline gap-3 mb-1">
          <h2 class="font-display text-2xl font-bold text-ink">{title(cmd.name)}</h2>
          <code class="font-mono text-sm text-coral/70">pncli {cmd.name}</code>
        </div>
        {cmd.description && (
          <p class="text-ink/60 mb-4">{cmd.description}</p>
        )}

        {/* Group-level options (e.g. bitbucket --project / ado --collection) */}
        {cmd.options.length > 0 && (
          <div class="mb-6">
            <p class="font-mono text-xs uppercase tracking-wider text-ink/30 mb-2">Group options</p>
            <div class="rounded-lg border border-ink/10 overflow-hidden">
              {cmd.options.map((opt, i) => (
                <div class={`px-4 py-2.5 flex gap-4 text-sm ${i > 0 ? 'border-t border-ink/5' : ''}`}>
                  <code class="font-mono text-xs text-coral shrink-0 w-56">{opt.flags}</code>
                  <span class="text-ink/60">{opt.description}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {cmd.subcommands.length > 0 ? (
          <div class="space-y-3">
            {cmd.subcommands.map(sub => (
              <details class="group rounded-lg border border-ink/10 overflow-hidden">
                <summary class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-ink/[0.03] transition-colors list-none">
                  <div class="flex items-baseline gap-3">
                    <code class="font-mono text-sm font-medium text-ink">{sub.name}</code>
                    {sub.description && (
                      <span class="text-sm text-ink/50">{sub.description}</span>
                    )}
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="shrink-0 text-ink/30 transition-transform group-open:rotate-90"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </summary>

                <div class="border-t border-ink/10 bg-ink/[0.02]">
                  <!-- Usage line -->
                  <div class="px-4 py-3 border-b border-ink/5">
                    <code class="font-mono text-xs text-ink/50">
                      pncli {cmd.name} {sub.name}{sub.options.length > 0 ? ' [options]' : ''}
                    </code>
                  </div>

                  {sub.options.length > 0 ? (
                    <div class="divide-y divide-ink/5">
                      {sub.options.map(opt => (
                        <div class="px-4 py-2.5 flex gap-4 text-sm">
                          <code class="font-mono text-xs text-coral shrink-0 w-56">{opt.flags}</code>
                          <span class="text-ink/60">{opt.description}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="px-4 py-3 text-sm text-ink/40 font-mono">no options</p>
                  )}
                </div>
              </details>
            ))}
          </div>
        ) : (
          <p class="text-sm text-ink/40 font-mono">no subcommands</p>
        )}
      </section>
    ))}
  </div>
</Base>
