---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Sparkles from '../components/Sparkles.astro';
import farewell from '../assets/maverick-wave.png';
import salute from '../assets/maverick-exit.png';
---

<Base>
  <!-- Farewell — MAVERICK, the brilliant one, says goodbye -->
  <section class="relative overflow-hidden w-full py-14 md:py-20 px-6 bg-cream">
    <Sparkles
      speed={0.06}
      max={20}
      opacity={0.35}
      sparks={[
        { x: 8, y: 18, s: 0.7, r: -14, c: 'straw', td: 7, tl: -2.2, dd: 12, dl: -3 },
        { x: 92, y: 30, s: 0.55, r: 16, c: 'gold', td: 8, tl: -4.4, dd: 13, dl: -6 },
        { x: 84, y: 86, s: 0.5, r: -22, c: 'straw', td: 6.4, tl: -1.6, dd: 11, dl: -2 },
      ]}
    />
    <div class="relative max-w-5xl mx-auto grid md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 md:gap-12 items-center">
      <Image
        src={farewell}
        alt="MAVERICK, the starry-eyed robot, waves goodbye with a warm smile as a few gold stars drift away."
        class="block w-full max-w-sm md:max-w-none mx-auto h-auto"
        loading="eager"
        data-parallax="0.05"
        data-parallax-max="16"
      />

      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-5">
        <p class="stamp text-gold">Out of office — permanently</p>

        <h1 class="font-display headline-shadow text-4xl md:text-5xl font-black text-ink leading-[1.05] tracking-tight">
          Hi friends.
        </h1>

        <div class="space-y-4 text-lg text-ink/70 leading-relaxed max-w-xl">
          <p>
            I've enjoyed meeting all of you and building this with your feedback.
            It's time for me to move on from this repository; I will no longer be supporting it.
          </p>
          <p>
            If you want to stay in touch, come visit the
            <a href="https://discord.gg/RKwEvAbtbx" target="_blank" rel="noopener noreferrer" class="text-gold font-semibold hover:underline">Context Overflow Discord</a>.
          </p>
          <p>
            I'm going to be making more tools for the AI era going forward — trying to reach
            the bureaucracies near and far that aren't ready for the rise of the developer.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mt-2">
          <a
            href="https://discord.gg/RKwEvAbtbx"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sticker bg-gold text-cream px-7 py-3 text-base"
          >
            Join the Discord
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <button
            type="button"
            id="bureaucracy-btn"
            class="btn-sticker bg-panel text-ink px-7 py-3 text-base cursor-pointer"
          >
            Message for the bureaucracy
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Succession notice — toil, the sequel -->
  <section class="w-full pb-14 md:pb-20 px-6 bg-cream">
    <div class="max-w-5xl mx-auto rounded-2xl border-[3px] border-ink/80 bg-panel shadow-[0_6px_0_rgb(0_0_0/0.35)] p-8 md:p-10">
      <p class="stamp text-gold mb-4">Form T-01 · Notice of succession</p>

      <h2 class="font-display headline-shadow text-3xl md:text-4xl font-black text-ink leading-[1.05] tracking-tight mb-5">
        pncli had a kid. Its name is toil.
      </h2>

      <p class="text-lg text-ink/70 leading-relaxed max-w-3xl mb-6">
        It's everything pncli was, minus the parts that made your security team sigh. Same idea of
        one install for every enterprise tool you're forced to use, but this time it's built properly.
      </p>

      <ul class="space-y-4 text-ink/70 leading-relaxed max-w-3xl mb-6">
        <li>
          <strong class="text-ink">It's an MCP server out of the box.</strong>
          Your org blocked MCP? toil stands in for the vendor server you were never allowed to install.
          One config entry, scoped to only the areas you need, and write tools that don't exist until you turn them on.
        </li>
        <li>
          <strong class="text-ink">It talks to your databases.</strong>
          PostgreSQL, MySQL, SQL Server, SQLite and Oracle. Connection strings are stored securely instead of
          in a sticky note named <code class="text-straw">final_v2_REAL.txt</code>. It's read-only by default,
          with a row cap, so your agent can't <code class="text-straw">SELECT *</code> the data warehouse into oblivion.
        </li>
        <li>
          <strong class="text-ink">It reads your code.</strong>
          Symbol search, definitions, references and call hierarchy, and every answer says where it came from.
        </li>
        <li>
          <strong class="text-ink">Zero executables. Zero install scripts. Zero browser logins. Zero telemetry.</strong>
          That leaves nothing for application control to block and nothing for the review board to schedule a meeting about.
        </li>
      </ul>

      <p class="text-ink/70 leading-relaxed max-w-3xl mb-6">
        All 22 integrations you know from pncli are on its list. It's pre-release, so for now the paperwork
        is still being processed. Star the repo and you'll hear when it lands on npm.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://github.com/imagile-dev/toil"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-sticker bg-gold text-cream px-7 py-3 text-base"
        >
          Star toil on GitHub
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
        <a
          href="https://imagile-dev.github.io/toil/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-sticker bg-panel text-ink px-7 py-3 text-base"
        >
          Learn more
        </a>
      </div>
    </div>
  </section>

  <!-- The message for the bureaucracy: the whole page becomes MAVERICK's salute -->
  <dialog id="bureaucracy-dialog" class="salute-dialog" aria-label="A message for the bureaucracy">
    <button type="button" class="salute-inner" data-close aria-label="Close">
      <Image
        src={salute}
        alt="MAVERICK, the starry-eyed robot, strolls away grinning over his shoulder and flips the viewer the middle finger."
        class="salute-img"
        widths={[512, 1024]}
        sizes="(min-height: 900px) 60vh, 90vw"
      />
      <span class="stamp text-gold">Filed. Approved. Stamped.</span>
    </button>
  </dialog>
</Base>

<style>
  .salute-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .salute-dialog::backdrop {
    background: var(--color-cream);
  }
  .salute-dialog[open] .salute-img {
    animation: salute-rise 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  .salute-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2vh 1rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .salute-img {
    display: block;
    height: calc(100dvh - 7rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @keyframes salute-rise {
    from { transform: translateY(40%) scale(0.6) rotate(-6deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .salute-dialog[open] .salute-img { animation: none; }
  }
</style>

<script>
  import '../scripts/parallax';

  const dialog = document.getElementById('bureaucracy-dialog') as HTMLDialogElement | null;
  document.getElementById('bureaucracy-btn')?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
</script>
