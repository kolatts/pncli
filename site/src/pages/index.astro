---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Sparkles from '../components/Sparkles.astro';
import farewell from '../assets/maverick-wave.png';
import salute from '../assets/maverick-exit.png';
---

<Base>
  <!-- Farewell — MAVERICK, the brilliant one, says goodbye -->
  <section class="relative overflow-hidden w-full py-14 md:py-20 px-6 bg-cream">
    <Sparkles
      speed={0.06}
      max={20}
      opacity={0.35}
      sparks={[
        { x: 8, y: 18, s: 0.7, r: -14, c: 'straw', td: 7, tl: -2.2, dd: 12, dl: -3 },
        { x: 92, y: 30, s: 0.55, r: 16, c: 'gold', td: 8, tl: -4.4, dd: 13, dl: -6 },
        { x: 84, y: 86, s: 0.5, r: -22, c: 'straw', td: 6.4, tl: -1.6, dd: 11, dl: -2 },
      ]}
    />
    <div class="relative max-w-5xl mx-auto grid md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 md:gap-12 items-center">
      <Image
        src={farewell}
        alt="MAVERICK, the starry-eyed robot, waves goodbye with a warm smile as a few gold stars drift away."
        class="block w-full max-w-sm md:max-w-none mx-auto h-auto"
        loading="eager"
        data-parallax="0.05"
        data-parallax-max="16"
      />

      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-5">
        <p class="stamp text-gold">Out of office — permanently</p>

        <h1 class="font-display headline-shadow text-4xl md:text-5xl font-black text-ink leading-[1.05] tracking-tight">
          Hi friends.
        </h1>

        <div class="space-y-4 text-lg text-ink/70 leading-relaxed max-w-xl">
          <p>
            I've enjoyed meeting all of you and building this with your feedback.
            It's time for me to move on from this repository; I will no longer be supporting it.
          </p>
          <p>
            If you want to stay in touch, come visit the
            <a href="https://discord.gg/tADvygJJgV" target="_blank" rel="noopener noreferrer" class="text-gold font-semibold hover:underline">Context Overflow Discord</a>.
          </p>
          <p>
            I'm going to be making more tools for the AI era going forward — trying to reach
            the bureaucracies near and far that aren't ready for the rise of the developer.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mt-2">
          <a
            href="https://discord.gg/tADvygJJgV"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sticker bg-gold text-cream px-7 py-3 text-base"
          >
            Join the Discord
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <button
            type="button"
            id="bureaucracy-btn"
            class="btn-sticker bg-panel text-ink px-7 py-3 text-base cursor-pointer"
          >
            Message for the bureaucracy
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- The message for the bureaucracy: the whole page becomes MAVERICK's salute -->
  <dialog id="bureaucracy-dialog" class="salute-dialog" aria-label="A message for the bureaucracy">
    <button type="button" class="salute-inner" data-close aria-label="Close">
      <Image
        src={salute}
        alt="MAVERICK, the starry-eyed robot, strolls away grinning over his shoulder and flips the viewer the middle finger."
        class="salute-img"
        widths={[512, 1024]}
        sizes="(min-height: 900px) 60vh, 90vw"
      />
      <span class="stamp text-gold">Filed. Approved. Stamped.</span>
    </button>
  </dialog>
</Base>

<style>
  .salute-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .salute-dialog::backdrop {
    background: var(--color-cream);
  }
  .salute-dialog[open] .salute-img {
    animation: salute-rise 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  .salute-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2vh 1rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .salute-img {
    display: block;
    height: calc(100dvh - 7rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @keyframes salute-rise {
    from { transform: translateY(40%) scale(0.6) rotate(-6deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .salute-dialog[open] .salute-img { animation: none; }
  }
</style>

<script>
  import '../scripts/parallax';

  const dialog = document.getElementById('bureaucracy-dialog') as HTMLDialogElement | null;
  document.getElementById('bureaucracy-btn')?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
</script>
