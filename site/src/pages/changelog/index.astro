---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sortChangelogEntries } from '../../lib/changelog';

const allEntries = await getCollection('changelog');

// Sort newest version first (semver descending)
const entries = sortChangelogEntries(allEntries);

// Group by year
const byYear = entries.reduce<Record<number, typeof entries>>((acc, entry) => {
  const year = entry.data.date.getFullYear();
  (acc[year] ??= []).push(entry);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const tagLabel: Record<string, string> = { feat: 'feat', fix: 'fix', breaking: 'breaking' };
const tagClass: Record<string, string> = {
  feat:     'bg-gold/10 text-gold border border-gold/30',
  fix:      'bg-coral/10 text-coral border border-coral/30',
  breaking: 'bg-ink text-cream',
};

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Changelog — pncli" description="Every pncli release, in one place.">
  <div class="max-w-4xl mx-auto px-6 py-10">
    <div class="mb-8">
      <p class="stamp text-gold mb-4">The paper trail</p>
      <h1 class="font-display headline-shadow text-5xl font-black text-ink tracking-tight mb-3">Changelog</h1>
      <p class="text-ink/50 text-lg">Every release, in one place.</p>
      <a
        href="/pncli/changelog/rss.xml"
        class="inline-flex items-center gap-1.5 text-sm text-ink/40 hover:text-gold transition-colors mt-3"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        RSS feed
      </a>
    </div>

    {years.map(year => (
      <div class="mb-10">
        <p class="font-mono text-sm text-ink/30 mb-3">{year}</p>
        <div class="divide-y divide-ink/5">
          {byYear[year].map(entry => (
            <a
              href={`/pncli/changelog/${entry.data.version}/`}
              class="flex items-start gap-4 py-4 group hover:bg-ink/[0.02] -mx-3 px-3 rounded-lg transition-colors"
            >
              <span class="font-mono text-xs font-bold border-2 border-gold text-gold px-2 py-0.5 rounded-md shrink-0 mt-0.5">
                v{entry.data.version}
              </span>
              <span class="text-xs text-ink/40 shrink-0 mt-1.5 w-14">
                {fmt.format(entry.data.date)}
              </span>
              <div class="flex flex-wrap gap-1.5 shrink-0 mt-0.5">
                {entry.data.tags.map(tag => (
                  <span class={`text-xs font-mono px-2 py-0.5 rounded-full ${tagClass[tag]}`}>
                    {tagLabel[tag]}
                  </span>
                ))}
              </div>
              <p class="text-sm text-ink/70 group-hover:text-ink transition-colors leading-relaxed">
                {entry.data.summary}
              </p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Base>
