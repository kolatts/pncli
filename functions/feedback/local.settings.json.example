{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "GITHUB_APP_ID": "<imagile-bot-github-app-id — remove this and GITHUB_APP_PRIVATE_KEY to use GITHUB_TOKEN instead; a placeholder left here fails startup>",
    "GITHUB_APP_PRIVATE_KEY": "<imagile-bot-app-private-key-pem contents (\\n for newlines) — or remove both App settings and use GITHUB_TOKEN below>",
    "GITHUB_APP_INSTALLATION_ID": "<optional: skips the per-repo installation lookup; usually leave unset>",
    "GITHUB_TOKEN": "<local-dev fallback: fine-grained-pat-with-issues:write-on-kolatts/pncli>",
    "GITHUB_REPO": "kolatts/pncli",
    "GITHUB_ISSUE_LABEL": "from-website",
    "ALLOWED_ORIGIN": "http://localhost:4321",
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "DAILY_SUBMISSION_LIMIT": "100",
    "IP_DAILY_LIMIT": "10",
    "ACS_CONNECTION_STRING": "<your-acs-connection-string>",
    "EMAIL_FROM_ADDRESS": "no-reply@imagile.dev",
    "WEBHOOK_API_KEY": "<any-random-string-for-local-testing>",
    "SMOKE_TEST_KEY": "<any random string; an X-Smoke-Test-Key header matching it skips Turnstile. Leave unset to disable>"
  }
}
